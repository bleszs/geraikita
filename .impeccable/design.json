      "description": "Outlined alternate action with tint on hover.",
      "html": "<button class=\"ds-secondary\">Lihat saran kulakan<svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-secondary{font-family:Nunito,'Segoe UI',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:11px 18px;border:1px solid transparent;border-radius:9px;font-size:14px;line-height:1.55;font-weight:800;white-space:nowrap;cursor:pointer}.ds-secondary:disabled{cursor:not-allowed;opacity:.55}.ds-secondary svg{flex-shrink:0}.ds-secondary:focus-visible{outline:3px solid var(--focus,#8d421e);outline-offset:4px}.ds-secondary{background:transparent;color:var(--ink,#382c24);border-color:var(--line,#e7ded1)}.ds-secondary:hover:not(:disabled){background:var(--tint,#f8eee3);border-color:var(--muted,#75665b)}"
    },
    {
      "name": "Text Action",
      "kind": "button",
      "refersTo": "text-action",
      "description": "Compact terracotta action within a section.",
      "html": "<button class=\"ds-text-action\">Lihat stok<svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-text-action{font-family:Nunito,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:7px;min-height:36px;padding:3px 0;border:0;background:none;color:var(--accent,#a3452b);font-weight:800;font-size:13px;line-height:1.55;cursor:pointer}.ds-text-action:hover{text-decoration:underline;text-underline-offset:4px}.ds-text-action:disabled{cursor:not-allowed;opacity:.55}.ds-text-action svg{flex-shrink:0}.ds-text-action:focus-visible{outline:3px solid var(--focus,#8d421e);outline-offset:4px}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Labeled theme control with an inline line icon.",
      "html": "<button class=\"ds-icon-button\" aria-label=\"Gunakan tema gelap\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 14a8 8 0 0 1-10-10 9 9 0 1 0 10 10Z\"/></svg></button>",
      "css": ".ds-icon-button{font-family:Nunito,'Segoe UI',sans-serif;width:42px;height:42px;display:inline-flex;align-items:center;justify-content:center;background:none;color:var(--ink,#382c24);border:1px solid var(--line,#e7ded1);border-radius:9px;cursor:pointer}.ds-icon-button:hover{background:var(--tint,#f8eee3)}.ds-icon-button:disabled{cursor:not-allowed;opacity:.55}.ds-icon-button:focus-visible{outline:3px solid var(--focus,#8d421e);outline-offset:4px}"
    },
    {
      "name": "Labeled Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Canvas field with visible label and keyboard outline.",
      "html": "<label class=\"ds-field-label\" for=\"ds-demand\">Kebutuhanmu (butir)<input class=\"ds-field\" id=\"ds-demand\" type=\"number\" min=\"1\" max=\"100\" value=\"18\"></label>",
      "css": ".ds-field-label{font-family:Nunito,'Segoe UI',sans-serif;display:block;color:var(--ink,#382c24);font-size:13px;font-weight:700;line-height:1.55;margin:16px 0 8px}.ds-field{font-family:Nunito,'Segoe UI',sans-serif;display:block;width:100%;border:1px solid var(--line,#e7ded1);border-radius:8px;background:var(--canvas,#fcfaf6);color:var(--ink,#382c24);caret-color:var(--accent,#a3452b);padding:11px 12px;min-height:45px;margin-top:7px;font-weight:500;font-size:14px;line-height:1.55}.ds-field::placeholder{color:var(--muted,#75665b);opacity:1}.ds-field:focus-visible{outline:3px solid var(--focus,#8d421e);outline-offset:4px}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Current and default links retain written task labels.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigasi contoh\"><a href=\"#ringkasan\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V10Z\"/><path d=\"M9 21v-8h6v8\"/></svg>Ringkasan</a><a href=\"#stok\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 3 9 5v8l-9 5-9-5V8l9-5Z\"/><path d=\"m3 8 9 5 9-5M12 13v8M7.5 5.5l9 5\"/></svg>Produk &amp; stok</a></nav>",
      "css": ".ds-nav{font-family:Nunito,'Segoe UI',sans-serif;display:flex;flex-direction:column;gap:5px;background:var(--rail,#f3eee5);padding:12px}.ds-nav a{display:flex;align-items:center;gap:12px;font-size:14px;line-height:1.55;font-weight:700;border-radius:9px;min-height:46px;padding:10px 14px;color:var(--muted,#75665b);text-decoration:none}.ds-nav a:hover,.ds-nav a[aria-current=page]{background:var(--accent-soft,#f7e7d9);color:var(--accent-ink,#75351f)}.ds-nav a[aria-current=page]{font-weight:800}.ds-nav svg{flex-shrink:0}.ds-nav a:focus-visible{outline:3px solid var(--focus,#8d421e);outline-offset:4px}"
    },
    {
      "name": "Written Status Tags",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Neutral, warm, warning and sufficient-stock tags; informational rather than interactive.",
      "html": "<div class=\"ds-tags\"><span class=\"ds-tag\">Data contoh</span><span class=\"ds-tag ds-tag-warm\">Simulasi kelompok</span><span class=\"ds-tag ds-tag-warn\">Stok menipis</span><span class=\"ds-tag ds-tag-good\">Stok cukup</span></div>",
      "css": ".ds-tags{display:flex;flex-wrap:wrap;gap:8px}.ds-tag{font-family:Nunito,'Segoe UI',sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:26px;font-size:11px;line-height:1.4;border-radius:5px;padding:4px 8px;background:var(--rail,#f3eee5);color:var(--muted,#75665b);font-weight:800;white-space:nowrap}.ds-tag-warm{background:var(--accent-soft,#f7e7d9);color:var(--accent-ink,#75351f)}.ds-tag-warn{background:var(--warn-bg,#f8ebd6);color:var(--warn,#8b5424)}.ds-tag-good{background:var(--green-bg,#e9f0e8);color:var(--green,#3d6653)}"
    },
    {
      "name": "Work Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat paper container with a fine edge and clear heading.",
      "html": "<section class=\"ds-panel\"><h2>Jangan sampai habis</h2><p>Stok dan kebutuhan usaha contoh.</p></section>",
      "css": ".ds-panel{font-family:Nunito,'Segoe UI',sans-serif;padding:25px;background:var(--surface,#fffdf9);color:var(--ink,#382c24);border:1px solid var(--line,#e7ded1);border-radius:14px;min-width:0;line-height:1.55}.ds-panel h2{margin:0 0 18px;font-size:20px;letter-spacing:-.015em;line-height:1.3;font-weight:800;text-wrap:balance}.ds-panel p{margin:12px 0 0;color:var(--muted,#75665b);font-size:14px;max-width:70ch}@media(max-width:1200px){.ds-panel{padding:22px}}@media(max-width:360px){.ds-panel{padding:18px}}"
    },
    {
      "name": "Quantity Breakdown",
      "kind": "custom",
      "refersTo": "quantity-flow",
      "description": "Synthetic example showing demand minus approved surplus equals the remaining purchase.",
      "html": "<div class=\"ds-quantity\" aria-label=\"Rincian kebutuhan telur contoh\"><div><span>Kebutuhan kelompok</span><strong>46<small>butir</small></strong></div><span class=\"ds-operator\" aria-hidden=\"true\">?</span><div><span>Surplus disetujui</span><strong>10<small>butir</small></strong></div><span class=\"ds-operator\" aria-hidden=\"true\">=</span><div class=\"ds-result\"><span>Beli dari pemasok</span><strong>36<small>butir</small></strong></div></div>",
      "css": ".ds-quantity{font-family:Nunito,'Segoe UI',sans-serif;display:grid;grid-template-columns:1fr 20px 1fr 20px 1fr;gap:16px;align-items:center;padding:22px 0;color:var(--ink,#382c24);line-height:1.55}.ds-quantity>div>span{font-size:13px;display:block;color:var(--muted,#75665b)}.ds-quantity strong{font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1.2;display:block;margin-top:9px;font-variant-numeric:tabular-nums}.ds-quantity strong small{font-size:13px;font-weight:600;margin-left:8px;letter-spacing:0}.ds-operator{font-size:23px;color:var(--muted,#75665b);text-align:center}.ds-result strong{color:var(--accent,#a3452b)}@media(max-width:1200px){.ds-quantity{gap:10px}}@media(max-width:760px){.ds-quantity{grid-template-columns:1fr 10px 1fr 10px 1fr;gap:6px}.ds-quantity>div>span{font-size:10px}.ds-quantity strong{font-size:34px}.ds-quantity strong small{display:block;font-size:11px;margin-left:0}.ds-operator{font-size:18px}}"
    },
    {
      "name": "Responsive Stock Row",
      "kind": "custom",
      "refersTo": "stock-row",
      "description": "Inventory identity, available amount, written state and shelf-life context stack on phones.",
      "html": "<table class=\"ds-stock\"><thead><tr><th>Produk</th><th>Stok tersedia</th><th>Status</th><th>Masa simpan contoh</th></tr></thead><tbody><tr><td><div class=\"ds-product\"><span class=\"ds-symbol\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 3 9 5v8l-9 5-9-5V8l9-5Z\"/><path d=\"m3 8 9 5 9-5M12 13v8M7.5 5.5l9 5\"/></svg></span><div><strong>Telur ayam</strong><small>Ambang stok 15 butir</small></div></div></td><td><strong>8</strong> butir</td><td><span class=\"ds-stock-tag\">Stok menipis</span></td><td>2 hari lagi</td></tr></tbody></table>",
      "css": ".ds-stock{font-family:Nunito,'Segoe UI',sans-serif;width:100%;border-collapse:collapse;text-align:left;font-size:13px;line-height:1.55;white-space:nowrap;color:var(--ink,#382c24)}.ds-stock th{font-size:11px;font-weight:700;color:var(--muted,#75665b);padding:12px 14px;background:var(--rail,#f3eee5)}.ds-stock td{padding:18px 14px;border-bottom:1px solid var(--line,#e7ded1)}.ds-stock tbody tr:last-child td{border-bottom:0}.ds-stock strong{font-weight:800}.ds-product{display:flex;gap:12px;align-items:center}.ds-product small{display:block;margin-top:3px;color:var(--muted,#75665b);font-size:11px}.ds-symbol{height:37px;width:37px;display:inline-flex;align-items:center;justify-content:center;background:var(--rail,#f3eee5);color:var(--muted,#75665b);border-radius:9px;flex-shrink:0}.ds-stock-tag{display:inline-flex;align-items:center;justify-content:center;min-height:26px;font-size:11px;line-height:1.4;border-radius:5px;padding:4px 8px;background:var(--warn-bg,#f8ebd6);color:var(--warn,#8b5424);font-weight:800;white-space:nowrap}@media(max-width:760px){.ds-stock{white-space:normal}.ds-stock thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.ds-stock tbody{display:block}.ds-stock tr{display:grid;grid-template-columns:1fr 1fr;padding:16px 0;border-bottom:1px solid var(--line,#e7ded1)}.ds-stock tr:last-child{border-bottom:0}.ds-stock td{border:0;padding:0;font-size:13px}.ds-stock td:first-child{grid-column:1/-1;margin-bottom:12px}.ds-stock td:nth-child(2){padding-left:49px;align-self:center}.ds-stock td:nth-child(3){text-align:right;align-self:center}.ds-stock td:nth-child(4){grid-column:1/-1;padding:10px 0 0 49px;font-size:11px;color:var(--muted,#75665b)}.ds-stock td:nth-child(4):before{content:'Masa simpan: '}.ds-stock-tag{font-size:10px}}"
    }
  ],
  "narrative": {
    "northStar": "The Neighborhood Kedai",
    "overview": "Gerai Kita feels like a familiar neighborhood kedai: cream surfaces, deep terracotta actions, warm brown writing, and plain Indonesian labels. The user chose this warm direction. It supports owners making everyday stock and shared purchasing decisions with readable figures and explicit choices.\n\nThe implemented interface is moderately dense, with generous panel insets and compact secondary labels. Flat panels and fine separators organize the work; prominent arithmetic connects individual demand, collective demand, approved surplus, and the amount still to purchase. Dark mode preserves that warm material character through brown surfaces and peach terracotta accents.",
    "keyCharacteristics": [
      "Cream and terracotta as the familiar base and action pair.",
      "Rounded Nunito Sans text with bold, tabular figures.",
      "Flat panels, light borders, and restrained tonal grouping.",
      "Visible quantity breakdowns, units, and named status labels.",
      "Responsive task layouts with explicit keyboard focus."
    ],
    "rules": [
      {
        "name": "The Warm Ground Rule",
        "body": "Use the cream canvas and paper surfaces for light mode; carry the same warm character into the brown dark theme.",
        "section": "colors"
      },
      {
        "name": "The Named Status Rule",
        "body": "Success and warning colors accompany a written status; color alone does not explain a stock or approval state.",
        "section": "colors"
      },
      {
        "name": "The Legible Arithmetic Rule",
        "body": "Use tabular numerals for quantity flows, financial totals, ingredient calculations, and transaction values. Keep units visible and subordinate to the number.",
        "section": "typography"
      },
      {
        "name": "The Flat Workbench Rule",
        "body": "Resting work panels use tone and borders. Reserve the shipped shadow for temporary surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep cream surfaces, terracotta actions, and warm brown text together in light mode.",
      "**Do** retain the matching warm dark color assignments when switching theme.",
      "**Do** pair tabular quantities with clear units and written explanations.",
      "**Do** name stock and approval states in words as well as color.",
      "**Do** preserve the visible focus outline and the reduced-motion behavior.",
      "**Do** keep quantity breakdowns readable when their units stack on phones."
    ],
    "donts": [
      "**Don't** add resting shadows to ordinary work panels.",
      "**Don't** replace the locally hosted reading family with a decorative display face.",
      "**Don't** replace semantic stock and approval labels with color-only markers.",
      "**Don't** hide the remaining purchase quantity or its units to fit a smaller layout."
    ]
  }
}
